{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)"
  ],
  "enabledManagers": ["gomod", "npm", "github-actions", "dockerfile", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions in workflows that have a renovate comment above them",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[\\w-]+: '(?<currentValue>[^']+)'"
      ]
    }
  ],
  "baseBranchPatterns": ["$default", "release.1.14"],
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "14 days",
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "postUpdateOptions": ["gomodTidy"],
  "labels": ["dependencies"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security"]
  },
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "addLabels": ["go"]
    },
    {
      "matchManagers": ["npm"],
      "addLabels": ["javascript"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"]
    },
    {
      "description": "go.mod, setup-go and the build image must use the same Go version, so they move in one PR. Go patch releases carry security fixes and need no wait",
      "matchDepNames": ["go", "golang"],
      "groupName": "go",
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Renovate does not bump the go directive unless told to",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Only the Go build image is managed in Dockerfiles",
      "matchManagers": ["dockerfile"],
      "matchDepNames": ["!golang"],
      "enabled": false
    },
    {
      "description": "Without this, Renovate offers only the newest version, and a minor version hides the patch below it",
      "matchBaseBranches": ["release.1.14"],
      "separateMinorPatch": true
    },
    {
      "matchBaseBranches": ["release.1.14"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "The website is built from main only, so the release branch does not need its updates",
      "matchFileNames": ["docs/website/**", ".github/workflows/docs-website.yml"],
      "matchBaseBranches": ["release.1.14"],
      "enabled": false
    },
    {
      "matchFileNames": ["docs/website/**"],
      "groupName": "website dependencies"
    }
  ]
}
